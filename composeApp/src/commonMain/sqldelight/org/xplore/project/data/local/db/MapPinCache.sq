-- Table for caching Points of Interest locally
CREATE TABLE MapPinCache (
    id            TEXT NOT NULL PRIMARY KEY,
    label         TEXT NOT NULL,
    latitude      REAL NOT NULL,
    longitude     REAL NOT NULL,
    type          TEXT NOT NULL,
    description   TEXT,
    category      TEXT,
    imageUrl      TEXT,
    openingHours  TEXT,
    fee           TEXT,
    phone         TEXT,
    website       TEXT,
    cachedAt      INTEGER NOT NULL  -- epoch millis
);

-- Fetch all cached pins
selectAll:
SELECT * FROM MapPinCache;

-- Fetch cached pins within a geographic bounding box
selectInBoundingBox:
SELECT * FROM MapPinCache
WHERE latitude BETWEEN ? AND ?
  AND longitude BETWEEN ? AND ?;

-- Insert or replace a pin
insertPin:
INSERT OR REPLACE INTO MapPinCache(id, label, latitude, longitude, type, description, category, imageUrl, openingHours, fee, phone, website, cachedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Delete entries older than a given epoch
deleteExpired:
DELETE FROM MapPinCache WHERE cachedAt < ?;

-- Delete all cached data
deleteAll:
DELETE FROM MapPinCache;

-- Delete cached pins OUTSIDE a geographic bounding box (cache pruning)
deleteOutsideBoundingBox:
DELETE FROM MapPinCache
WHERE latitude < ? OR latitude > ?
   OR longitude < ? OR longitude > ?;

-- Search cached pins by name (case-insensitive LIKE)
searchByName:
SELECT * FROM MapPinCache
WHERE label LIKE '%' || ? || '%' COLLATE NOCASE;
